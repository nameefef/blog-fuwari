---
import { adsenseConfig } from "@/config";

interface Props {
	class?: string;
}
const className = Astro.props.class;
const hasManualSlot = adsenseConfig.enable && adsenseConfig.client && adsenseConfig.slot;
const autoAdsOnly = adsenseConfig.enable && adsenseConfig.client && !adsenseConfig.slot;
---
<div class:list={["card-base p-3", className]}>
    {hasManualSlot ? (
        <ins
            class="adsbygoogle"
            style="display:block"
            data-ad-client={adsenseConfig.client}
            data-ad-slot={adsenseConfig.slot}
            data-ad-format="auto"
            data-full-width-responsive="true"
        ></ins>
    ) : autoAdsOnly ? (
        <div class="flex items-center justify-center h-24 rounded-lg border border-dashed border-black/15 dark:border-white/15 text-black/40 dark:text-white/40 text-sm text-center px-4">
            本站已启用 Google AdSense 自动广告（Auto ads），Google 会自动在站内各处合适的位置展示广告，不固定出现在这里
        </div>
    ) : (
        <div class="flex items-center justify-center h-24 rounded-lg border border-dashed border-black/15 dark:border-white/15 text-black/30 dark:text-white/30 text-sm">
            广告位（未配置 AdSense）
        </div>
    )}
</div>

{hasManualSlot && (
    <script is:inline>
        (adsbygoogle = window.adsbygoogle || []).push({});
    </script>
)}
