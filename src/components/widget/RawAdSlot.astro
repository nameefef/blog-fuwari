---
import type { RawAdSlotConfig } from "@/types/config";

interface Props {
	config: RawAdSlotConfig;
	name: string;
	class?: string;
}
const { config, name } = Astro.props;
const className = Astro.props.class;
const ready = config.enable && config.code;
---
<div class:list={["card-base p-3", className]}>
    {ready ? (
        <Fragment set:html={config.code} />
    ) : (
        <div class="flex items-center justify-center h-24 rounded-lg border border-dashed border-black/15 dark:border-white/15 text-black/30 dark:text-white/30 text-sm">
            广告位（未配置 {name}）
        </div>
    )}
</div>
